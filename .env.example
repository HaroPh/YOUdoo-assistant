# ─── LLM providers (SP-1) ────────────────────────────────────────────────────
GOOGLE_API_KEY=thay_bang_key_that
GROQ_API_KEY=thay_bang_key_that
OPENROUTER_API_KEY=thay_bang_key_that

# ─── Postgres (sổ ngân sách + checkpointer LangGraph) ────────────────────────
DATABASE_URL=postgresql://admin:thay_bang_mat_khau@localhost:5434/ai_assistant

# ─── Langfuse (kế hoạch C2, self-host) ──────────────────────────────────────
LANGFUSE_HOST=http://localhost:3001
# 2 khoá dưới ĐỒNG THỜI là API key backend dùng để gửi trace, VÀ giá trị
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY của docker-compose.yml's
# langfuse-web (headless init — tự tạo org/project/key khi DB `langfuse`
# còn trống lúc boot đầu, không cần qua UI). Đặt giá trị TẠI ĐÂY trước khi
# lần đầu `docker compose --profile observability up -d`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Tài khoản admin headless-init tạo sẵn trên Langfuse UI (không phải API key).
LANGFUSE_INIT_USER_EMAIL=admin@youdoo.local
LANGFUSE_INIT_USER_PASSWORD=thay_bang_mat_khau_langfuse
# 6 biến dưới CHỈ dùng để dựng hạ tầng self-host (docker-compose.yml's
# profile observability).
LANGFUSE_NEXTAUTH_SECRET=thay_bang_secret_that
LANGFUSE_SALT=thay_bang_salt_that
# 64 ký tự hex — sinh bằng: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=thay_bang_64_ky_tu_hex
LANGFUSE_REDIS_AUTH=thay_bang_mat_khau_redis
LANGFUSE_CLICKHOUSE_PASSWORD=thay_bang_mat_khau_clickhouse
LANGFUSE_MINIO_ROOT_PASSWORD=thay_bang_mat_khau_minio

# ─── Backend HTTP server (kế hoạch C2) ──────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# ─── Odoo (kế hoạch B) ───────────────────────────────────────────────────────
ODOO_URL=http://host.docker.internal:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=thay_bang_mat_khau

# ─── MCP server Odoo (BA tiến trình riêng, SSE — spec 2026-08-09-role-based-
# access): mỗi vai (admin/warehouse/accounting) chạy MỘT tiến trình
# mcp-servers/odoo/server.py RIÊNG, đăng nhập Odoo bằng tài khoản AI riêng
# của vai đó — cô lập theo tiến trình, không theo tham số, nên bug định
# tuyến vai chỉ gây "sai bộ tool", không leo thang quyền. `start-dev.ps1` tự
# khởi cả 3 (đọc PLAN 3 vai trong file đó) — KHÔNG cần tự chạy tay từng cái.
MCP_ODOO_URL=http://localhost:8003/sse               # vai admin (ai-admin)
MCP_ODOO_URL_WAREHOUSE=http://localhost:8004/sse     # vai kho (ai-warehouse)
MCP_ODOO_URL_ACCOUNTING=http://localhost:8005/sse    # vai kế toán (ai-accounting)
# Port mcp-servers/odoo/server.py TỰ lắng nghe — phải khớp port trong
# MCP_ODOO_URL ở trên. 8003, không phải 8001 mặc định của D:\Project (cùng
# gốc codebase, trùng port từng gây backend Youdoo nhận nhầm request test
# của D:\Project — xem plan 2026-08-05-cross-project-port-collision-fix).
MCP_ODOO_PORT=8003
# Số lệnh gọi ERP tối đa mỗi phút, phía MCP server (mcp-servers/odoo/config.py:10).
MCP_RATE_LIMIT=60
# Mật khẩu CHUNG của 4 tài khoản AI (ai-readonly/ai-admin/ai-warehouse/
# ai-accounting) — tạo bằng scripts/odoo_setup_ai_accounts.py. KHÔNG đặt giá
# trị thật ở file .env.example này (file này được commit); chỉ điền thật vào
# .env cục bộ (đã gitignore).
AI_ACCOUNT_PASSWORD=thay_bang_mat_khau_ai_that

# ─── Phân quyền theo vai (spec 2026-08-09-role-based-access) ─────────────────
# Hồ sơ chính sách vai — xem backend/src/agents/roles.py PROFILES. Bỏ trống =
# mặc định "small-business". Đổi "enterprise" nếu tách nhỏ trách nhiệm kho
# (xem docstring roles.py).
YOUDOO_POLICY_PROFILE=small-business
# Ánh xạ user_id Open WebUI (chuỗi mờ, KHÔNG phải email/tên) → vai. Định dạng
# "id1:admin,id2:warehouse,id3:accounting". User KHÔNG có trong bảng này bị
# TỪ CHỐI HOÀN TOÀN — đây là thiết kế (fail-closed), không phải lỗi: một
# checkout mới với biến này để trống sẽ khiến MỌI người dùng, kể cả admin
# thật, bị từ chối cho tới khi được thêm vào đây.
#
# Cách lấy user_id thật: đăng nhập tài khoản đó ở Open WebUI (mặc định
# http://localhost:3002), gửi một tin nhắn bất kỳ, rồi tìm dòng ghi header
# "x-openwebui-user-id" tương ứng trong logs/backend.log (hoặc log tương
# đương nếu chạy thủ công, không qua start-dev.ps1). Giá trị này chỉ xuất
# hiện nếu ENABLE_FORWARD_USER_INFO_HEADERS=true ở container open-webui —
# xem ngay dưới.
YOUDOO_ROLE_MAP=
# BẮT BUỘC để phân quyền theo vai hoạt động: không có header này, backend
# không suy được user_id → mọi người dùng bị từ chối (fail-closed), bất kể
# YOUDOO_ROLE_MAP điền gì. Đặt ở docker-compose.yml (khối open-webui.environment),
# không phải ở đây — nêu lại để không ai quên khi tự dựng compose file riêng.
# ENABLE_FORWARD_USER_INFO_HEADERS=true

# ─── Agents ERP (kế hoạch B) ──────────────────────────────────────────────────
# TTL (giây) cho câu hỏi xác nhận trước khi ghi ERP (create_order.py:56, nodes.py:270).
CONFIRMATION_TTL_SECONDS=300
# Điểm khớp tối thiểu để resolve.py tự chọn kết quả, không hỏi lại (resolve.py:103).
ERP_RESOLVE_AUTOPICK_FLOOR=0.6
# Khoảng cách điểm tối thiểu giữa top-1 và top-2 để tự chọn (resolve.py:104).
ERP_RESOLVE_AUTOPICK_GAP=0.15
# Công tắc khẩn cấp tắt SOP skill agentic (tier 2); "0" là giá trị tắt duy nhất được nhận (skill_gate.py:12).
ERP_SKILLS_ENABLED=1

# ─── RAG ─────────────────────────────────────────────────────────────────────
# RAG_DB_DSN mặc định lấy DATABASE_URL ở trên — dùng chung DB với sổ ngân sách.
# OLLAMA_URL: instance RIÊNG của Youdoo (container youdoo-ollama trong
# docker-compose.yml), KHÔNG còn dùng chung với D:\Project (đổi 2026-08-06,
# xem docs/superpowers/specs/2026-08-06-rag-ollama-isolation-design.md).
OLLAMA_URL=http://localhost:11435
RAG_SCHEMA=public
# RAG_EMBED_PROVIDER — công tắc CHÍNH mà toàn bộ thiết kế multi-provider
# embedding ở spec §3b xoay quanh. Mặc định "ollama" (embed.py:131); đặt
# "gemini" để chuyển sang GeminiEmbedder — nhưng đổi sau khi đã index dữ
# liệu sẽ làm lệch không gian vector (xem assert_embedding_marker()).
RAG_EMBED_PROVIDER=ollama
# Reranker nạp lười, fail-open. Đặt 0 để bỏ hẳn (không tải model 2.3GB).
RAG_RERANK_ENABLED=1
# Ngưỡng cosine để synthesis.py coi RAG là "không đủ thông tin" (synthesis.py:15).
RAG_NO_RESULT_COS_FLOOR=0.35
# Thư mục nguồn cho script CLI ingest (ingest.py:115) — chỉ dùng ở CLI, không phải đường test/runtime.
DOCUMENTS_PATH=.
# Test luôn tắt cờ này qua fixture autouse — đây là mặc định cho chạy thật.
ERP_SEMANTIC_RESOLVE=0
